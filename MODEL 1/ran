import random

secret = random.randint(1, 50)
lives = 5

print("I'm thinking of a number between 1 and 50.")

while lives > 0:
    print(f"Lives: {'*' * lives}")
    guess =  int(input("Guess: "))

    if guess == secret:
        print("You got it!")
        break
    
    lives -= 1
    
    if lives > 0:
        if abs(guess - secret) < 5:
            print("So close!")
        elif guess < secret:
            print("Too low!")
        else:
            print("Too high!")
    else:
        print(f"Game over. It was {secret}.")
